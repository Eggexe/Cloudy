CC      := gcc
TARGET  := PongGameDemo
BUILD   := build
CLOUDY  := .

# Sources: the game's own .c files plus every Cloudy module's .c files
GAME_SRCS   := $(wildcard *.c)
CLOUDY_SRCS := $(wildcard $(CLOUDY)/*/*.c)
SRCS        := $(GAME_SRCS) $(CLOUDY_SRCS)
OBJS        := $(SRCS:%.c=$(BUILD)/%.o)
DEPS        := $(OBJS:.o=.d)

CFLAGS  := -Wall -Wextra -std=c99 -g -I. -I$(CLOUDY) \
           -I/usr/local/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT
LDFLAGS := -L/usr/local/lib
LDLIBS  := -lSDL2 -lSDL2_ttf -lfreetype -lm

# Usage: make STATIC=1
ifeq ($(STATIC),1)
    LDFLAGS += -static
endif

.PHONY: all clean

all: $(TARGET)

$(TARGET): $(OBJS)
	$(CC) $(OBJS) -o $@ $(LDFLAGS) $(LDLIBS)

# Objects go in build/, mirroring the source tree
$(BUILD)/%.o: %.c
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -MMD -MP -c $< -o $@

# Header dependency tracking (generated by -MMD)
-include $(DEPS)

clean:
	rm -rf $(BUILD) $(TARGET)
