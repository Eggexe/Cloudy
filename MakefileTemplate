CC = gcc
CFLAGS = -I/usr/include/SDL2 -D_GNU_SOURCE=1 -D_REENTRANT -I.
LIBS = -L/usr/lib -lSDL2 -lSDL2_ttf

CLOUDY_OBJS = Entity/entity.o Events/events.o \
              Ext/misc.o Input/input_man.o \
              Physics/physics.o Render/drawing.o \
              Render/simple_window.o UI/ui.o

all: $(CLOUDY_OBJS)
	$(CC) $(CFLAGS) $(CLOUDY_OBJS) -o Cloudy $(LIBS)

%.o: %.c
	$(CC) $(CFLAGS) -c $< -o $@

clean:
	rm -f $(CLOUDY_OBJS) Cloudy
